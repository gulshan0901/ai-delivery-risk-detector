# Generate a long random value (at least 32 bytes) and keep it server-side.
APP_API_KEY=replace_with_a_long_random_access_key

OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4.1

JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=replace_with_a_least_privilege_jira_token
JIRA_PROJECT_KEY=DEMO
JIRA_JQL=project = DEMO ORDER BY priority ASC, updated DESC
JIRA_MAX_RESULTS=20

# Comma-separated exact origins. Never use * in production.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
MAX_REQUEST_BYTES=750000

# Frontend deployment setting (not a secret):
VITE_API_URL=https://your-backend.example.com
